# ==================================================
# KONECTA - Variáveis de ambiente (referência global)
# ==================================================
# Este arquivo é apenas um exemplo. Nunca commitar valores reais.
# Cada aplicação (api, mobile, admin) possui seu próprio .env.example.

# Banco de dados (usado pelo Prisma e pelo Docker Compose)
POSTGRES_USER=konecta
POSTGRES_PASSWORD=changeme
POSTGRES_DB=konecta
POSTGRES_PORT=5432
DATABASE_URL=postgresql://konecta:changeme@localhost:5432/konecta?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Ambiente
NODE_ENV=development
