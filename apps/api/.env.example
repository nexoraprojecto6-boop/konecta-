NODE_ENV=development
PORT=3000

# PostgreSQL (via Prisma)
DATABASE_URL=postgresql://konecta:changeme@localhost:5432/konecta?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:3001

# Autenticação (Fase 2)
# Gere um valor forte real (ex: openssl rand -hex 32) — nunca use este valor de exemplo em produção.
JWT_SECRET=troque_este_valor_por_um_segredo_forte_com_pelo_menos_32_caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
